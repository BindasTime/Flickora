# Flickora environment
# Copy to `.env` and fill in. `.env` is gitignored; nothing here is a secret
# except FREEBUFF_API_KEY (server-side only, never bundled into the app).

# --- AdMob ---------------------------------------------------------------
# Public client-side IDs. Run `npm run admob:setup` to fill these in and patch
# the Android manifest in one step. Values below are Google's test IDs.
VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712
# Set to true to stop every ad request (useful for screenshots and demos).
VITE_ADMOB_DISABLED=false
# Highest ad creative rating allowed: General | ParentalGuidance | Teen | MatureAudience.
# Must match AdMob → App settings → Ad content rating.
VITE_ADMOB_MAX_AD_RATING=Teen
# Keep true until AdMob approval is finished. It serves test ads even with live
# IDs, which avoids invalid traffic on your own devices. Set false only after
# the app is approved and your test devices are registered in AdMob.
VITE_ADMOB_FORCE_TEST_ADS=true

# --- NVIDIA NIM — AI movie finder ----------------------------------------
# Any VITE_* value is bundled into the app and is readable by end users.
# Restrict this key in the NVIDIA console before distributing the app.
# Empty value disables the AI movie finder in Search.
VITE_NVIDIA_API_KEY=
VITE_NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Freebuff Developer API (server-side only) ---------------------------
# No VITE_ prefix: Vite never exposes these to the browser bundle.
FREEBUFF_BASE_URL=https://freebuff.com/api/v1/paid
FREEBUFF_API_KEY=
